classDiagram
    direction LR
    class API["Dobby API"] {
        <<Application>>
        basePath = /api/v1
    }
    class R0["vehicles"] {
        <<Resource>>
        +GET(filters QueryParams) 200
    }
    class R1["{vehicleId}"] {
        <<Resource>>
        +GET() 200
    }
    class VehicleListResponse {
        <<Representation>>
        success : boolean
        count : integer
        pagination : Pagination
        data : Vehicle[]
    }
    class VehicleResponse {
        <<Representation>>
        success : boolean
        data : Vehicle
    }
    R0 ..> VehicleListResponse : «use» response
    API --> R0 : «Path» /vehicles
    R1 ..> VehicleResponse : «use» response
    R0 --> R1 : «Path» /{vehicleId}
