# Application configuration.
NODE_ENV=development
PORT=5003
# Fill locally. Do not commit real connection strings or credentials.
MONGO_URI=
TEST_MONGO_URI=
JWT_SECRET=
# Auth sessions use the fixed 24-hour lifetime in the API contract.
# Seed inputs are supplied locally by the developer, never hardcoded.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Explicit guard required by the future reset:test implementation.
ALLOW_TEST_DB_RESET=false
