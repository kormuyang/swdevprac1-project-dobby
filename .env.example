# Copy to .env and fill in the uppercase URI placeholders.
NODE_ENV=development
PORT=5003

# App, tests and admin setup/reset share the dobby database.
# Use your Atlas database user and cluster hostname; keep /dobby in the URI.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/dobby?retryWrites=true&w=majority
# Example values are for local development. Auth sessions last 24 hours.
JWT_SECRET=dobby-secret

# Admin creation. Password must contain 8–72 UTF-8 bytes.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=admin1234
# reset:test deletes the entire shared dobby database. Keep disabled normally.
ALLOW_TEST_DB_RESET=false
