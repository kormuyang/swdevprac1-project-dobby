# Application configuration.
NODE_ENV=development
PORT=5003
# Fill locally. Do not commit real connection strings or credentials.
MONGO_URI=
TEST_MONGO_URI=
# B model integration tests use the separate dobby_test_b database.
TEST_MONGO_URI_B=
JWT_SECRET=
# Auth sessions use the fixed 24-hour lifetime in the API contract.
# Seed inputs are supplied locally by the developer, never hardcoded.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_FIXTURE_PASSWORD=
# Explicit guard required by the reset:test command.
ALLOW_TEST_DB_RESET=false
