{
  "info": {
    "name": "Dobby A: Auth and company lifecycle",
    "description": "Local A journey: company signup, application reviews and history, suspension, logout, and reactivation. Runtime credentials are supplied by scripts/test-demo.js.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "A: Auth and company lifecycle",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('admin login returns a session', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.environment.set('adminToken', pm.response.json().data.token); }"
          ] } }]
        },
        {
          "name": "Register synthetic company and pending application v1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{legalNameV1}}\",\n  \"telephone\": \"+66000000000\",\n  \"email\": \"{{companyEmail}}\",\n  \"password\": \"{{companyPassword}}\",\n  \"businessRegistrationNumber\": \"{{registrationNumber}}\",\n  \"profile\": {\n    \"legalName\": \"{{legalNameV1}}\",\n    \"registeredAddress\": \"1 Synthetic Demo Road, Bangkok\",\n    \"telephone\": \"+66000000000\",\n    \"contactEmail\": \"{{contactEmail}}\",\n    \"documentUrl\": \"https://example.test/demo-registration.pdf\"\n  }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/register-company"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('company signup returns 201', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) {",
            "  const body = pm.response.json().data;",
            "  pm.test('signup creates a company account', function () { pm.expect(body.user.role).to.eql('company'); });",
            "  pm.environment.set('companyToken', body.token);",
            "  pm.environment.set('providerId', body.user.providerId);",
            "}"
          ] } }]
        },
        {
          "name": "Company reads application v1",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{companyToken}}" }],
            "url": "{{baseUrl}}/company/applications"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('company can read own application history', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) {",
            "  const applications = pm.response.json().data;",
            "  const versionOne = applications.find((application) => application.version === 1);",
            "  pm.test('version one is pending', function () { pm.expect(versionOne.status).to.eql('pending'); });",
            "  pm.environment.set('applicationV1Id', versionOne.id);",
            "}"
          ] } }]
        },
        {
          "name": "Admin approves application v1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"approve\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/admin/applications/{{applicationV1Id}}/review"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('admin approves version one', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.test('review status is approved', function () { pm.expect(pm.response.json().data.status).to.eql('approved'); }); }"
          ] } }]
        },
        {
          "name": "Company submits profile revision v2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{companyToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"legalName\": \"{{legalNameV2}}\",\n  \"registeredAddress\": \"2 Synthetic Demo Road, Bangkok\",\n  \"telephone\": \"+66000000000\",\n  \"contactEmail\": \"{{contactEmail}}\",\n  \"documentUrl\": \"https://example.test/demo-revision-v2.pdf\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/company/applications"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('company submits version two', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.environment.set('applicationV2Id', pm.response.json().data.id); }"
          ] } }]
        },
        {
          "name": "Approved profile remains active while revision is pending",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{companyToken}}" }],
            "url": "{{baseUrl}}/company/profile"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('company profile remains readable', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) {",
            "  const provider = pm.response.json().data;",
            "  pm.test('approved profile is unchanged during review', function () { pm.expect(provider.approvedProfile.legalName).to.eql(pm.environment.get('legalNameV1')); });",
            "}"
          ] } }]
        },
        {
          "name": "Admin rejects revision v2 with a reason",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"reject\",\n  \"reason\": \"Synthetic demo review: please clarify the registered address.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/admin/applications/{{applicationV2Id}}/review"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('admin rejects the revision', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) {",
            "  const application = pm.response.json().data;",
            "  pm.test('rejection reason is returned', function () { pm.expect(application.rejectionReason).to.include('Synthetic demo review'); });",
            "}"
          ] } }]
        },
        {
          "name": "Company reads both immutable application versions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{companyToken}}" }],
            "url": "{{baseUrl}}/company/applications"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('company can read version history', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) {",
            "  const applications = pm.response.json().data;",
            "  const versionOne = applications.find((application) => application.version === 1);",
            "  const versionTwo = applications.find((application) => application.version === 2);",
            "  pm.test('history preserves reviewed versions and reason', function () {",
            "    pm.expect(versionOne.status).to.eql('approved');",
            "    pm.expect(versionTwo.status).to.eql('rejected');",
            "    pm.expect(versionTwo.rejectionReason).to.include('Synthetic demo review');",
            "  });",
            "}"
          ] } }]
        },
        {
          "name": "Company resubmits corrected profile v3",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{companyToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"legalName\": \"{{legalNameV3}}\",\n  \"registeredAddress\": \"3 Synthetic Demo Road, Bangkok\",\n  \"telephone\": \"+66000000000\",\n  \"contactEmail\": \"{{contactEmail}}\",\n  \"documentUrl\": \"https://example.test/demo-revision-v3.pdf\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/company/applications"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('company resubmits as version three', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.environment.set('applicationV3Id', pm.response.json().data.id); }"
          ] } }]
        },
        {
          "name": "Admin approves revision v3",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"approve\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/admin/applications/{{applicationV3Id}}/review"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('admin approves version three', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.test('review status is approved', function () { pm.expect(pm.response.json().data.status).to.eql('approved'); }); }"
          ] } }]
        },
        {
          "name": "Admin suspends the approved provider",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Synthetic A demo suspension.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/admin/providers/{{providerId}}/suspend"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('admin suspends approved provider', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.test('provider status is suspended', function () { pm.expect(pm.response.json().data.provider.status).to.eql('suspended'); }); }"
          ] } }]
        },
        {
          "name": "Suspended company cannot read current account",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{companyToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('suspension blocks existing protected sessions', function () { pm.response.to.have.status(403); });"
          ] } }]
        },
        {
          "name": "Suspended company login is denied",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{companyEmail}}\",\n  \"password\": \"{{companyPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('suspended company cannot create a fresh session', function () { pm.response.to.have.status(403); });"
          ] } }]
        },
        {
          "name": "Suspended company can log out",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{companyToken}}" }],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('logout remains allowed during suspension', function () { pm.response.to.have.status(200); });"
          ] } }]
        },
        {
          "name": "Logged out company token is revoked",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{companyToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('logged out token is rejected', function () { pm.response.to.have.status(401); });"
          ] } }]
        },
        {
          "name": "Admin reactivates provider",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"resolutionNote\": \"Synthetic demo issue resolved.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/admin/providers/{{providerId}}/reactivate"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('admin reactivates provider', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) {",
            "  pm.test('provider returns to approved state', function () { pm.expect(pm.response.json().data.status).to.eql('approved'); });",
            "  pm.environment.unset('adminToken');",
            "}"
          ] } }]
        },
        {
          "name": "Company logs in after reactivation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{companyEmail}}\",\n  \"password\": \"{{companyPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('reactivated company can log in', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.environment.set('companyToken', pm.response.json().data.token); }"
          ] } }]
        },
        {
          "name": "Company confirms approved revision v3",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{companyToken}}" }],
            "url": "{{baseUrl}}/company/profile"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('company can read profile after reactivation', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) {",
            "  const provider = pm.response.json().data;",
            "  pm.test('approved revision v3 is current', function () {",
            "    pm.expect(provider.status).to.eql('approved');",
            "    pm.expect(provider.approvedProfile.legalName).to.eql(pm.environment.get('legalNameV3'));",
            "  });",
            "}",
            "pm.environment.unset('companyToken');",
            "pm.environment.unset('adminToken');",
            "pm.environment.unset('companyPassword');"
          ] } }]
        }
      ]
    }
  ]
}
