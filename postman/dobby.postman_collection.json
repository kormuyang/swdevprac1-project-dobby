{
  "info": {
    "name": "Dobby complete rental journey",
    "description": "Synthetic local A+B journey: authentication, provider review, vehicles, booking changes, emergency cancellation, suspension and reactivation. Runtime credentials and tokens must not be exported.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Auth and onboarding",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin login returns a session', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.environment.set('adminToken', pm.response.json().data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Synthetic Demo Customer\", \"telephone\": \"123456789\", \"email\": \"{{customerEmail}}\", \"password\": \"{{customerPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('customer signup returns 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { const data = pm.response.json().data; pm.test('signup assigns customer role and safe output', function () { pm.expect(data.user.role).to.eql('user'); pm.expect(data.user).not.to.have.property('passwordHash'); }); pm.environment.set('customerToken', data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer reads own account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('customer reads own account', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.test('account email belongs to the customer', function () { pm.expect(pm.response.json().data.email).to.eql(pm.environment.get('customerEmail')); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Register synthetic provider and pending application v1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{legalNameV1}}\",\n  \"telephone\": \"+66000000000\",\n  \"email\": \"{{providerEmail}}\",\n  \"password\": \"{{providerPassword}}\",\n  \"businessRegistrationNumber\": \"{{registrationNumber}}\",\n  \"profile\": {\n    \"legalName\": \"{{legalNameV1}}\",\n    \"registeredAddress\": \"1 Synthetic Demo Road, Bangkok\",\n    \"telephone\": \"+66000000000\",\n    \"contactEmail\": \"{{contactEmail}}\",\n    \"documentUrl\": \"https://example.test/demo-registration.pdf\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register-provider"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('provider signup returns 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json().data;",
                  "  pm.test('signup creates a provider account', function () { pm.expect(body.user.role).to.eql('provider'); });",
                  "  pm.environment.set('providerToken', body.token);",
                  "  pm.environment.set('providerId', body.user.providerId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Provider reads application v1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ],
            "url": "{{baseUrl}}/provider/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('provider can read own application history', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const applications = pm.response.json().data;",
                  "  const versionOne = applications.find((application) => application.version === 1);",
                  "  pm.test('version one is pending', function () { pm.expect(versionOne.status).to.eql('pending'); });",
                  "  pm.environment.set('applicationV1Id', versionOne.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Provider review and versions",
      "item": [
        {
          "name": "Admin approves application v1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/applications/{{applicationV1Id}}/review"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin approves version one', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.test('review status is approved', function () { pm.expect(pm.response.json().data.status).to.eql('approved'); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Provider submits profile revision v2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legalName\": \"{{legalNameV2}}\",\n  \"registeredAddress\": \"2 Synthetic Demo Road, Bangkok\",\n  \"telephone\": \"+66000000000\",\n  \"contactEmail\": \"{{contactEmail}}\",\n  \"documentUrl\": \"https://example.test/demo-revision-v2.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/provider/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('provider submits version two', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.environment.set('applicationV2Id', pm.response.json().data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Approved profile remains active while revision is pending",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ],
            "url": "{{baseUrl}}/provider/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('provider profile remains readable', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const provider = pm.response.json().data;",
                  "  pm.test('approved profile is unchanged during review', function () { pm.expect(provider.approvedProfile.legalName).to.eql(pm.environment.get('legalNameV1')); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin rejects revision v2 with a reason",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"reject\",\n  \"reason\": \"Synthetic demo review: please clarify the registered address.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/applications/{{applicationV2Id}}/review"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin rejects the revision', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const application = pm.response.json().data;",
                  "  pm.test('rejection reason is returned', function () { pm.expect(application.rejectionReason).to.include('Synthetic demo review'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Provider reads both immutable application versions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ],
            "url": "{{baseUrl}}/provider/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('provider can read version history', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const applications = pm.response.json().data;",
                  "  const versionOne = applications.find((application) => application.version === 1);",
                  "  const versionTwo = applications.find((application) => application.version === 2);",
                  "  pm.test('history preserves reviewed versions and reason', function () {",
                  "    pm.expect(versionOne.status).to.eql('approved');",
                  "    pm.expect(versionTwo.status).to.eql('rejected');",
                  "    pm.expect(versionTwo.rejectionReason).to.include('Synthetic demo review');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Provider resubmits corrected profile v3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legalName\": \"{{legalNameV3}}\",\n  \"registeredAddress\": \"3 Synthetic Demo Road, Bangkok\",\n  \"telephone\": \"+66000000000\",\n  \"contactEmail\": \"{{contactEmail}}\",\n  \"documentUrl\": \"https://example.test/demo-revision-v3.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/provider/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('provider resubmits as version three', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.environment.set('applicationV3Id', pm.response.json().data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin approves revision v3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/applications/{{applicationV3Id}}/review"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin approves version three', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.test('review status is approved', function () { pm.expect(pm.response.json().data.status).to.eql('approved'); }); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Vehicles and bookings",
      "item": [
        {
          "name": "Create provider vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/provider/vehicles",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{providerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"vin\": \"V-{{runId}}\", \"model\": \"Demo City\", \"transmissionType\": \"automatic\", \"fuelType\": \"hybrid\", \"seatingCapacity\": 5, \"pickupBranch\": {\"name\": \"Branch A\", \"address\": \"Synthetic Road\"}, \"ratePerDaySatang\": 100000, \"availableFrom\": \"{{today}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create provider vehicle: HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('vehicleId', data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Discover vehicle for requested dates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/vehicles?providerId={{providerId}}&startDate={{startDate}}&dueDate={{dueDate}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Discover vehicle for requested dates: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "pm.test('filtered discovery contains the vehicle', function () { pm.expect(data.map(v => v.id)).to.include(pm.environment.get('vehicleId')); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Book vehicle at server rate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"vehicleId\": \"{{vehicleId}}\", \"startDate\": \"{{startDate}}\", \"dueDate\": \"{{dueDate}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Book vehicle at server rate: HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('bookingId', data.id);",
                  "pm.test('three inclusive days at booked rate', function () { pm.expect(data.rentalDays).to.eql(3); pm.expect(data.totalPriceSatang).to.eql(300000); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Provider reads current customer and booked details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/provider/bookings/{{bookingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{providerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Provider reads current customer and booked details: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "pm.test('contact is current and safe', function () { pm.expect(data.customer.email).to.eql(pm.environment.get('customerEmail')); pm.expect(data.customer).not.to.have.property('passwordHash'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Change listing branch and rate",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/provider/vehicles/{{vehicleId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{providerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"pickupBranch\": {\"name\": \"Branch B\", \"address\": \"Changed Road\"}, \"ratePerDaySatang\": 120000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Change listing branch and rate: HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit dates while retaining agreed price",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings/{{bookingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"startDate\": \"{{editStart}}\", \"dueDate\": \"{{editDue}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Edit dates while retaining agreed price: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "pm.test('snapshot and original rate remain fixed', function () { pm.expect(data.ratePerDaySatang).to.eql(100000); pm.expect(data.totalPriceSatang).to.eql(200000); pm.expect(data.vehicleSnapshot.pickupBranch.name).to.eql('Branch A'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer cancels before start",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/bookings/{{bookingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer cancels before start: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "pm.environment.set('cancelledAt', data.cancelledAt);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeated cancellation has no new effect",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/bookings/{{bookingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Repeated cancellation has no new effect: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "pm.test('cancellation timestamp is unchanged', function () { pm.expect(data.cancelledAt).to.eql(pm.environment.get('cancelledAt')); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create same-day rental",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"vehicleId\": \"{{vehicleId}}\", \"startDate\": \"{{today}}\", \"dueDate\": \"{{today}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create same-day rental: HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('ongoingId', data.id);",
                  "pm.test('same-day rental is ongoing', function () { pm.expect(data.status).to.eql('ongoing'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin emergency-cancels ongoing rental",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/bookings/{{ongoingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin emergency-cancels ongoing rental: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "pm.test('admin cancellation reason is recorded', function () { pm.expect(data.cancellationReason).to.eql('admin_cancelled'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create rental for suspension check",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"vehicleId\": \"{{vehicleId}}\", \"startDate\": \"{{suspensionStart}}\", \"dueDate\": \"{{suspensionStart}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create rental for suspension check: HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('suspensionBookingId', data.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Suspension and reactivation",
      "item": [
        {
          "name": "Admin suspends the approved provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Synthetic A demo suspension.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/providers/{{providerId}}/suspend"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin suspends approved provider', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.test('provider status is suspended', function () { pm.expect(pm.response.json().data.provider.status).to.eql('suspended'); }); }",
                  "pm.test('suspension cancels the remaining active rental', function () { pm.expect(pm.response.json().data.cancelledBookingCount).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer sees suspension cancellation",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/bookings/{{suspensionBookingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer sees suspension cancellation: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "pm.test('suspension reason is recorded', function () { pm.expect(data.status).to.eql('cancelled'); pm.expect(data.cancellationReason).to.eql('provider_suspended'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Suspended vehicle is hidden publicly",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Suspended vehicle is hidden publicly: HTTP 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Suspended provider cannot read current account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('suspension blocks existing protected sessions', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Suspended provider login is denied",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{providerEmail}}\",\n  \"password\": \"{{providerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('suspended provider cannot create a fresh session', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Suspended provider can log out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logout remains allowed during suspension', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Logged out provider token is revoked",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged out token is rejected', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin reactivates provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionNote\": \"Synthetic demo issue resolved.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/providers/{{providerId}}/reactivate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin reactivates provider', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  pm.test('provider returns to approved state', function () { pm.expect(pm.response.json().data.status).to.eql('approved'); });",
                  "  pm.environment.unset('adminToken');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Provider logs in after reactivation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{providerEmail}}\",\n  \"password\": \"{{providerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reactivated provider can log in', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.environment.set('providerToken', pm.response.json().data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Provider sees cancelled booking after reactivation",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/provider/bookings/{{suspensionBookingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{providerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Provider sees cancelled booking after reactivation: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "pm.test('reactivation does not restore a booking', function () { pm.expect(data.status).to.eql('cancelled'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Provider confirms approved revision v3",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ],
            "url": "{{baseUrl}}/provider/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('provider can read profile after reactivation', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const provider = pm.response.json().data;",
                  "  pm.test('approved revision v3 is current', function () {",
                  "    pm.expect(provider.status).to.eql('approved');",
                  "    pm.expect(provider.approvedProfile.legalName).to.eql(pm.environment.get('legalNameV3'));",
                  "  });",
                  "}",
                  "pm.environment.unset('providerToken');",
                  "pm.environment.unset('adminToken');",
                  "pm.environment.unset('providerPassword');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Logout",
      "item": [
        {
          "name": "Customer logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('customer logs out', function () { pm.response.to.have.status(200); });",
                  "pm.environment.unset('customerToken'); pm.environment.unset('customerPassword');"
                ]
              }
            }
          ]
        }
      ]
    }
